# Copy this file to .streamlit/secrets.toml and fill in the real values.
# NEVER commit the filled-in secrets.toml to git or share it — it contains credentials.

SHEET_URL_OR_KEY = "https://docs.google.com/spreadsheets/d/PASTE_YOUR_SHEET_ID_HERE/edit"

# Optional — only needed if you turn on the "AI insights" toggle in the sidebar
OPENAI_API_KEY = "sk-..."

# Paste the ENTIRE contents of the service account JSON key file here,
# under the [gcp_service_account] table, matching field names exactly.
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "your-service-account@your-project-id.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
